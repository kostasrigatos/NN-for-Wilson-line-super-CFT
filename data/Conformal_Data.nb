Cell[TextData[{
 "Our best estimate for the OPE bounds, obtained as described in the paper \
with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["N", "der"], "=", "140"}], TraditionalForm]],ExpressionUUID->
  "9b794cc2-2180-41d2-b59e-581dd7ca4e50"],
 ".\nThe format for each point is:   { g ,  {",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    SubscriptBox[
     SuperscriptBox["C", "2"], 
     RowBox[{"i", ",", "lower"}]]}], TraditionalForm]],ExpressionUUID->
  "c4040d67-c71b-49bd-9060-6fac902ae18a"],
 "(g) , ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["C", "2"], 
    RowBox[{"i", ",", "upper"}]], TraditionalForm]],ExpressionUUID->
  "8e313468-7a7e-4eb8-9826-3230bbb1bc7f"],
 "(g)  } } ."
}], "Text",
