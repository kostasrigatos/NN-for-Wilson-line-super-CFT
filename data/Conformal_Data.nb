8a5cb1bbf592"],

Cell[TextData[{
 "Correlator ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{"G", "(", "x", ")"}], "=", 
     FractionBox[
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"\[LeftAngleBracket]", " ", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalPhi]", "\[UpTee]"], "(", 
          SubscriptBox["x", "1"], ")"}], " ", 
         RowBox[{
          SubscriptBox["\[CapitalPhi]", "\[UpTee]"], "(", 
          SubscriptBox["x", "2"], ")"}], " ", 
         RowBox[{
          SubscriptBox["\[CapitalPhi]", "\[UpTee]"], "(", 
          SubscriptBox["x", "3"], ")"}], " ", 
         RowBox[{
          SubscriptBox["\[CapitalPhi]", "\[UpTee]"], "(", 
          SubscriptBox["x", "4"], ")"}]}], "\[RightAngleBracket]"}], 
       "\[RightAngleBracket]"}], 
      RowBox[{
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{"\[LeftAngleBracket]", " ", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[CapitalPhi]", "\[UpTee]"], "(", 
           SubscriptBox["x", "1"], ")"}], " ", 
          RowBox[{
           SubscriptBox["\[CapitalPhi]", "\[UpTee]"], "(", 
           SubscriptBox["x", "2"], ")"}]}], " ", "\[RightAngleBracket]"}], 
        "\[RightAngleBracket]"}], 
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{"\[LeftAngleBracket]", " ", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[CapitalPhi]", "\[UpTee]"], "(", 
           SubscriptBox["x", "3"], ")"}], " ", 
          RowBox[{
           SubscriptBox["\[CapitalPhi]", "\[UpTee]"], "(", 
           SubscriptBox["x", "4"], ")"}]}], " ", "\[RightAngleBracket]"}], 
        "\[RightAngleBracket]"}]}]], " "}]}], TraditionalForm]],
  ExpressionUUID->"60ae4bcc-1329-4bd9-baec-9d3e1e1a78cd"],
 "  up to order ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", "4"], TraditionalForm]],ExpressionUUID->
  "55ddca8f-79e9-4198-ab14-cd47aaff2a14"],
 " in terms of HPL.\nThe package HPL.m is needed (more info in \
[hep-ph/0507152] and [hep-ph/0703052])."
}], "Text",
